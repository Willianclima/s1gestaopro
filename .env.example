# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Geocoding / Places API Key for address validation and mapping.
VITE_GOOGLE_MAPS_API_KEY=""

# PostgreSQL Connection Configuration for Drizzle ORM
DATABASE_URL=""
POSTGRES_URL=""
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="postgres"

# Drizzle Studio Configuration
DRIZZLE_STUDIO_PORT="4983"
DRIZZLE_STUDIO_HOST="0.0.0.0"

# Backend Authentication & Security
# SESSION_SECRET: Chave secreta de alta entropia (mínimo 32 caracteres / openssl rand -hex 32)
# para assinatura criptográfica HMAC-SHA256 de tokens de sessão do servidor.
SESSION_SECRET=""

# ADMIN_PASSWORD: Senha forte para autenticação administrativa no endpoint /api/auth/verify-admin.
# Se não configurada, o endpoint de administrador falhará de forma segura rejeitando acessos.
ADMIN_PASSWORD=""

# ==============================================================================
# Variáveis de Isolamento e Execução Segura de Testes (Preflight Mandatório)
# ==============================================================================
# A suíte integrada com escrita (npm run test:security) é estritamente fail-closed
# e recusa qualquer escrita a menos que as 3 variáveis obrigatórias abaixo sejam
# declaradas e coincidam positivamente com a conexão real do PostgreSQL no servidor:

# TEST_DATABASE_NAME: Nome exato do banco de dados isolado autorizado para testes
# Exemplo: s1gestao_test ou cloud_sql_development_database
TEST_DATABASE_NAME=""

# TEST_DB_USER: Nome exato da conta de teste dedicada com privilégios mínimos
# Não pode ser superusuário, proprietário nem ter acesso a bancos de produção.
# Exemplo: test_user ou s1_test_user
TEST_DB_USER=""

# TEST_INSTANCE_ID: Identificador exato da instância Cloud SQL (PROJECT:REGION:INSTANCE)
# ou endpoint TCP/host autorizado de teste (ex: 127.0.0.1 ou localhost).
TEST_INSTANCE_ID=""

# Script SQL revisável para provisionar o ambiente isolado de teste no PostgreSQL:
# ------------------------------------------------------------------------------
# -- 1. Criar banco isolado exclusivo para a suíte de testes
# CREATE DATABASE s1gestao_test;
#
# -- 2. Criar conta exclusiva de testes com privilégios mínimos (sem SUPERUSER, CREATEDB, etc.)
# CREATE USER test_user WITH PASSWORD 'senha_de_teste_segura';
#
# -- 3. Conceder privilégios estritamente no banco de teste
# GRANT CONNECT ON DATABASE s1gestao_test TO test_user;
# \c s1gestao_test
# GRANT USAGE, CREATE ON SCHEMA public TO test_user;
# GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO test_user;
# GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO test_user;
# ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO test_user;
#
# -- 4. Garantir ausência de privilégios de conexão ou escrita em bancos produtivos
# REVOKE ALL ON DATABASE cloud_sql_production_database FROM test_user;
# REVOKE CONNECT ON DATABASE cloud_sql_production_database FROM PUBLIC;
# ------------------------------------------------------------------------------

