# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Geocoding / Places API Key for address validation and mapping.
VITE_GOOGLE_MAPS_API_KEY=""

# PostgreSQL Connection Configuration for Drizzle ORM
DATABASE_URL=""
POSTGRES_URL=""
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="postgres"

# Drizzle Studio Configuration
DRIZZLE_STUDIO_PORT="4983"
DRIZZLE_STUDIO_HOST="0.0.0.0"

# Backend Authentication & Security
# SESSION_SECRET: Chave secreta de alta entropia (mínimo 32 caracteres / openssl rand -hex 32)
# para assinatura criptográfica HMAC-SHA256 de tokens de sessão do servidor.
SESSION_SECRET=""

# ADMIN_PASSWORD: Senha forte para autenticação administrativa no endpoint /api/auth/verify-admin.
# Se não configurada, o endpoint de administrador falhará de forma segura rejeitando acessos.
ADMIN_PASSWORD=""

# ==============================================================================
# Variáveis de Ambiente de Isolamento e Execução Segura de Testes
# ==============================================================================
# A suíte de testes integrados (npm run test:security) é estritamente fail-closed:
# ela rejeita qualquer execução ou escrita a menos que uma instância de teste
# isolada e uma conta dedicada com privilégios mínimos sejam comprovadas pelo preflight.
#
# Para executar os testes integrados em um ambiente de teste dedicado, configure:
# 1. TEST_DATABASE_NAME: Nome do banco isolado autorizado (ex: s1gestao_test ou cloud_sql_development_database)
# 2. TEST_DB_USER: Nome da conta de teste restrita (ex: s1_test_user ou test_user)
# 3. TEST_INSTANCE_ID: Identificador da instância Cloud SQL (PROJECT:REGION:INSTANCE) ou host TCP (ex: 127.0.0.1)
# 4. As variáveis de conexão do cliente (DATABASE_URL ou SQL_*) apontando exatamente para os mesmos valores acima.
#
# Se qualquer uma dessas variáveis estiver ausente, se houver divergência entre as variáveis e a
# conexão real no PostgreSQL, se o usuário possuir privilégios administrativos (SUPERUSER, CREATEDB, etc.)
# ou se a conta tiver acesso a outros bancos não autorizados na instância, a suíte abortará
# imediatamente antes da primeira escrita.

TEST_DATABASE_NAME=""
TEST_DB_USER=""
TEST_INSTANCE_ID=""

# ==============================================================================
# Guia de Provisionamento de Banco e Usuário de Teste (Somente Instância Isolada)
# ==============================================================================
# ATENÇÃO: Os comandos abaixo devem ser executados EXCLUSIVAMENTE em uma instância
# dedicada e isolada de testes. NUNCA execute alterações em instâncias de produção
# ou compartilhadas.
#
# -- 1. Criar banco isolado exclusivo para a suíte de testes:
# CREATE DATABASE s1gestao_test;
#
# -- 2. Criar conta descartável exclusiva com privilégios estritamente locais (sem SUPERUSER, CREATEDB, etc.):
# CREATE USER s1_test_user WITH PASSWORD '<definir_senha_forte_temporaria>';
#
# -- 3. Conceder permissões mínimas restritas apenas ao banco de teste:
# GRANT CONNECT ON DATABASE s1gestao_test TO s1_test_user;
# \c s1gestao_test
# GRANT USAGE, CREATE ON SCHEMA public TO s1_test_user;
# GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO s1_test_user;
# GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO s1_test_user;
# ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO s1_test_user;
# ==============================================================================


