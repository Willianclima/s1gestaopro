# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Geocoding / Places API Key for address validation and mapping.
VITE_GOOGLE_MAPS_API_KEY=""

# PostgreSQL Connection Configuration for Drizzle ORM
DATABASE_URL=""
POSTGRES_URL=""
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="postgres"

# Drizzle Studio Configuration
DRIZZLE_STUDIO_PORT="4983"
DRIZZLE_STUDIO_HOST="0.0.0.0"

# Backend Authentication & Security
# SESSION_SECRET: Chave secreta de alta entropia (mínimo 32 caracteres / openssl rand -hex 32)
# para assinatura criptográfica HMAC-SHA256 de tokens de sessão do servidor.
SESSION_SECRET=""

# ADMIN_PASSWORD: Senha forte para autenticação administrativa no endpoint /api/auth/verify-admin.
# Se não configurada, o endpoint de administrador falhará de forma segura rejeitando acessos.
ADMIN_PASSWORD=""

# ==============================================================================
# Variáveis de Isolamento e Execução Segura de Testes (Preflight Mandatório)
# ==============================================================================
# TEST_DATABASE_NAME: Nome explícito e inequívoco do banco de dados isolado autorizado
# para testes (ex: s1gestao_test ou cloud_sql_development_database).
# A suíte de testes com escrita recusa execução (fail-closed) se esta variável não for informada
# ou se divergir da conexão real do PostgreSQL.
TEST_DATABASE_NAME=""

# TEST_DB_USER: (Opcional) Usuário de conexão de teste autorizado (ex: test_user ou ai_studio_app_user).
# Rejeita usuários privilegiados/administrativos não confirmados (como root ou admin).
TEST_DB_USER=""

# TEST_INSTANCE_ID: (Opcional) Instância autorizada do Cloud SQL (PROJECT:REGION:INSTANCE)
# ou host TCP de teste. Previne conexão inadvertida com instâncias de produção.
TEST_INSTANCE_ID=""

# TEST_ALLOW_SUPERUSER: (Opcional, padrão: false) Defina 'true' apenas em containers
# locais descartáveis de teste para dispensar a exigência de privilégios limitados.
TEST_ALLOW_SUPERUSER="false"

